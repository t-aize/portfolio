---
/**
 * Composed like a hanging scroll (kakemono): a title mark near the top,
 * a deliberately empty field (ma, 間), and the signature resting low —
 * rather than a headline sized to dominate the viewport.
 *
 * Two additions keep the field from reading as merely unfinished:
 * - a cursor halo that gives the field a quiet, ambient presence
 * - a vertical line (tategaki-style) as a second, smaller accent
 */

// Resolved at build time, not in the browser — a static site has no
// other clock to read from, and this only needs to be right as of the
// last deploy.
const year = new Date().getFullYear();
---

<!-- `isolate` keeps the halo's negative z-index contained to this section -->
<section
  class="relative isolate flex min-h-svh flex-col gap-[clamp(1.5rem,5vh,3rem)] bg-paper p-[clamp(1.75rem,6vw,4.5rem)]"
  data-hero
  data-snap-section
  aria-label="Introduction"
>
  <!-- Cursor halo: ambient presence in the empty field, desktop pointers only -->
  <div
    class="pointer-events-none absolute top-0 left-0 -z-10 -mt-[13rem] -ml-[13rem] h-[26rem] w-[26rem] rounded-full bg-[radial-gradient(circle,var(--color-accent)_0%,transparent_70%)] opacity-0 blur-3xl"
    data-hero-halo
    aria-hidden="true"
  ></div>

  <div class="flex max-w-[22rem] flex-col gap-3">
    <span
      class="block h-px w-full origin-left bg-line"
      data-reveal-line
      aria-hidden="true"
    ></span>
    <p
      class="m-0 text-xs font-normal tracking-[0.28em] text-ink-soft uppercase"
      data-reveal
      data-hero-eyebrow
    >
      Portfolio {year}
    </p>
  </div>

  <!--
    Right-side counter-mark to the eyebrow block: same rule + label anatomy,
    rotated — so the void has two quiet anchors (top-left, right-center)
    instead of one mark and one orphaned kanji.
    "一期一会" (ichigo ichie) — a tea-ceremony phrase: treat this encounter as
    unrepeatable. Purely decorative here, so it stays out of the a11y tree;
    swap the phrase for anything you actually want to say if you'd rather.
  -->
  <div
    class="pointer-events-none absolute top-1/2 right-[clamp(1.75rem,6vw,4.5rem)] hidden -translate-y-1/2 items-center gap-3 sm:flex"
    data-hero-vertical
    aria-hidden="true"
  >
    <span class="block h-16 w-px origin-top bg-line" data-reveal-line-vertical></span>
    <span
      class="pointer-events-auto block [writing-mode:vertical-rl] text-[0.85rem] tracking-[0.1em] text-ink-soft"
      data-reveal
      data-hero-vertical-text
      lang="ja"
    >
      一期一会
    </span>
  </div>

  <div class="mt-auto max-w-3xl">
    <h1
      class="m-0 text-[clamp(2.75rem,8vw,6rem)] leading-[1.05] font-light tracking-[-0.01em] text-ink"
      data-hero-name
    >
      Tom B.
    </h1>

    <p
      class="mt-[0.9rem] mb-0 text-sm font-normal tracking-[0.28em] text-ink-soft uppercase"
      data-reveal
      data-hero-role
    >
      Développeur &middot; Backend
    </p>
  </div>
</section>

<script>
  import "../scripts/hero";
</script>

<style>
  /* Belt-and-braces alongside the JS check: no halo without a real pointer */
  @media (hover: none), (pointer: coarse) {
    [data-hero-halo] {
      display: none;
    }
  }
</style>
