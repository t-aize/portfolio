---
/**
 * Composed like a hanging scroll (kakemono): a title mark near the top,
 * a deliberately empty field (ma, 間), and the signature resting low —
 * rather than a headline sized to dominate the viewport.
 *
 * The field is no longer empty-by-default: a full-viewport ink shader
 * (see scripts/ink/InkScene.ts) gives it a moving, physical presence, and
 * the name itself is repainted by scripts/kinetic-text/KineticText.ts as a
 * velocity-reactive glyph texture instead of a static heading. Both are
 * progressive enhancements — see the reduceMotion/WebGL-availability
 * branches in scripts/hero.ts for what renders when either is unavailable.
 */

// Resolved at build time, not in the browser — a static site has no
// other clock to read from, and this only needs to be right as of the
// last deploy.
const year = new Date().getFullYear();
---

<!-- `isolate` keeps the ink canvas's negative z-index contained to this section -->
<section
  class="relative isolate flex min-h-svh flex-col gap-[clamp(1.5rem,5vh,3rem)] overflow-hidden bg-paper p-[clamp(1.75rem,6vw,4.5rem)]"
  data-hero
  aria-label="Introduction"
>
  <!-- Ink shader canvas: fills the section, sits behind everything else.
       Starts fully transparent (uOpacity = 0) and is faded in by the
       entrance timeline in scripts/hero.ts, so it reads as ink bleeding
       into the paper rather than a generic fade-in. -->
  <canvas
    class="pointer-events-none absolute inset-0 -z-10"
    data-hero-ink-canvas
    aria-hidden="true"
  ></canvas>

  <!-- Loading state: WebGL setup and the document.fonts.ready wait in
       scripts/hero.ts aren't instant, and without this the page just sits
       there looking unfinished for that stretch. Hidden by default (only
       shown once html.js confirms JS is actually running — same reasoning
       as the [data-reveal] rules below, so a blocked script never leaves
       this stuck on screen) and removed by hero.ts once setup settles.

       The mark is an ensō (円相) — the single-stroke brush circle drawn in
       Zen practice — rather than a generic spinner, so the loading state
       stays inside the same visual language as the rest of the piece. It
       draws itself, holds, fades, and repeats via the CSS animation below;
       see the `pathLength="1"` trick, which lets stroke-dashoffset go
       0 -> 1 without computing the path's real length by hand. -->
  <div
    class="pointer-events-none absolute inset-0 z-20 flex items-center justify-center bg-paper"
    data-hero-loader
    aria-hidden="true"
  >
    <svg viewBox="0 0 100 100" class="h-16 w-16 sm:h-20 sm:w-20" data-hero-loader-mark>
      <path
        d="M 43.85 15.14 C 47.24 15.46, 58.92 14.07, 64.20 17.07 C 69.49 20.08, 72.15 27.69, 75.57 33.18 C 78.99 38.67, 84.22 44.06, 84.73 50.00 C 85.24 55.94, 82.17 63.60, 78.63 68.83 C 75.10 74.06, 69.36 78.59, 63.54 81.39 C 57.72 84.19, 49.48 87.16, 43.71 85.65 C 37.94 84.14, 33.38 76.98, 28.92 72.35 C 24.46 67.71, 19.03 63.60, 16.95 57.83 C 14.86 52.07, 16.50 41.12, 16.41 37.77"
        fill="none"
        stroke="var(--color-accent)"
        stroke-width="3.5"
        stroke-linecap="round"
        pathLength="1"
        data-hero-loader-stroke
      ></path>
    </svg>
  </div>

  <div class="flex max-w-[22rem] flex-col gap-3">
    <span
      class="block h-px w-full origin-left bg-line"
      data-reveal-line
      aria-hidden="true"
    ></span>
    <p
      class="-my-1 m-0 w-fit rounded-sm bg-paper/70 px-2 py-1 text-xs font-normal tracking-[0.28em] text-ink-soft uppercase backdrop-blur-sm"
      data-reveal
      data-hero-eyebrow
    >
      Portfolio {year}
    </p>
  </div>

  <!--
    Right-side counter-mark to the eyebrow block: same rule + label anatomy,
    rotated — so the void has two quiet anchors (top-left, right-center)
    instead of one mark and one orphaned kanji.
    "一期一会" (ichigo ichie) — a tea-ceremony phrase: treat this encounter as
    unrepeatable. Purely decorative here, so it stays out of the a11y tree;
    swap the phrase for anything you actually want to say if you'd rather.
  -->
  <div
    class="pointer-events-none absolute top-1/2 right-[clamp(1.75rem,6vw,4.5rem)] hidden -translate-y-1/2 items-center gap-3 sm:flex"
    data-hero-vertical
    aria-hidden="true"
  >
    <span class="block h-16 w-px origin-top bg-line" data-reveal-line-vertical></span>
    <span
      class="block rounded-sm bg-paper/70 px-1 py-2 [writing-mode:vertical-rl] text-[0.85rem] tracking-[0.1em] text-ink-soft backdrop-blur-sm"
      data-reveal
      data-hero-vertical-text
      lang="ja"
    >
      一期一会
    </span>
  </div>

  <div class="mt-auto max-w-3xl">
    <!--
      `relative` because KineticText.ts absolutely-positions its canvas as
      a child of this element once WebGL is confirmed working. The text
      node itself is never removed — only its color, so screen readers,
      text selection and "view source" all still see the real name.
    -->
    <h1
      class="relative m-0 text-[clamp(2.75rem,8vw,6rem)] leading-[1.05] font-light tracking-[-0.01em] text-ink"
      data-reveal
      data-hero-name
    >
      Tom B.
    </h1>

    <p
      class="mt-[0.9rem] mb-0 w-fit rounded-sm bg-paper/70 px-2 py-1 text-sm font-normal tracking-[0.28em] text-ink-soft uppercase backdrop-blur-sm"
      data-reveal
      data-hero-role
    >
      Développeur &middot; Backend
    </p>
  </div>
</section>

<script>
  import "../scripts/hero";
</script>
