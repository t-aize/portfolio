---
import Hero from "../components/Hero";
import "../styles/global.css";
import "lenis/dist/lenis.css";

// Resolved at build time, not in the browser — a static site has no other
// clock to read from, and this only needs to be right as of the last
// deploy. Passed down as a prop (rather than read inside Hero itself) so
// the value baked into the server-rendered HTML and the value used during
// client hydration are guaranteed identical, even across a year boundary.
const year = new Date().getFullYear();
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Tom B. · Portfolio</title>
    <meta name="description" content="Portfolio de développeur & designer." />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script>
      import "../lib/lenis";
    </script>
  </head>
  <body>
    <Hero client:load year={year} />
  </body>
</html>
