---
import Footer from "~/components/layout/Footer.astro";
import { ScrollRail } from "~/components/layout/ScrollRail.tsx";
import { SmoothScroll } from "~/components/layout/SmoothScroll.tsx";
import "~/styles/app.css";

interface Props {
  title?: string;
  description?: string;
}

const { title = "Tom B. · Portfolio", description = "Portfolio de développeur backend." } =
  Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link rel="icon" href="/favicon.ico">
  </head>
  <body class="flex min-h-dvh flex-col bg-cream text-ink">
    <SmoothScroll client:load />
    <ScrollRail client:load />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
