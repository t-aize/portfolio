{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint --write .",
    "lint:check": "biome lint .",
    "check": "biome check --write .",
    "ci": "biome ci .",
    "validate": "pnpm run ci && pnpm run typecheck && pnpm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@biomejs/biome": "^2.5.7",
    "@types/three": "^0.185.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,jsx,mjs,cjs,json,jsonc,css}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}
