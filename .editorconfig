# EditorConfig helps maintain consistent coding styles across editors and IDEs.
# https://editorconfig.org
#
# Indentation/line settings mirror the Biome formatter config in biome.json —
# keep both in sync if you change one.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.{astro,ts,tsx,js,jsx,mjs,cjs,json,jsonc,css,scss,yml,yaml,html,svg}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
max_line_length = off

[*.{lock,lockb}]
insert_final_newline = unset
trim_trailing_whitespace = unset

[pnpm-lock.yaml]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
max_line_length = off

[Makefile]
indent_style = tab

[*.{bat,cmd,ps1}]
end_of_line = crlf
